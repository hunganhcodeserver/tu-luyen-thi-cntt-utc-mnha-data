","text":"Admitted"},{"key":"C","text":"Exit"},{"key":"D","text":"Interrupt"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-21","clusterId":"mcq-c3"},{"startLine":132,"text":"Bước nào KHÔNG thuộc bốn bước tạo tiến trình trong bài?","image":null,"options":[{"key":"A","text":"Cấp PID và PCB"},{"key":"B","text":"Thiết lập không gian địa chỉ"},{"key":"C","text":"Kế thừa/cấp tài nguyên"},{"key":"D","text":"Ghi trạng thái kết thúc"}],"correct":["D"],"explanationHtml":null,"multi":false,"id":"mcq-22","clusterId":null},{"startLine":138,"text":"Trong bốn bước tạo tiến trình, bước cuối cùng là gì?","image":null,"options":[{"key":"A","text":"Cấp PID và PCB"},{"key":"B","text":"Đưa vào Ready queue"},{"key":"C","text":"Thiết lập không gian địa chỉ"},{"key":"D","text":"Kế thừa/cấp tài nguyên"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-23","clusterId":null},{"startLine":144,"text":"Sau khi tạo tiến trình con, quan hệ thực thi giữa cha và con có thể là gì?","image":null,"options":[{"key":"A","text":"Cha và con chạy đồng thời, hoặc cha chờ con hoàn tất"},{"key":"B","text":"Con luôn phải chạy xong trước khi cha tạo ra nó"},{"key":"C","text":"Cha luôn bị hủy ngay khi con được tạo"},{"key":"D","text":"Cha và con luôn có chung PID"}],"correct":["A"],"explanationHtml":null,"multi":false,"id":"mcq-24","clusterId":null},{"startLine":150,"text":"Cơ chế copy-on-write có tác dụng gì?","image":null,"options":[{"key":"A","text":"Sao chép toàn bộ bộ nhớ vật lý ngay khi tạo tiến trình con"},{"key":"B","text":"Ngăn tiến trình con ghi dữ liệu"},{"key":"C","text":"Trì hoãn sao chép vật lý cho đến khi có thao tác ghi"},{"key":"D","text":"Cho phép cha và con chia sẻ PID"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-25","clusterId":null},{"startLine":156,"text":"PPID dùng để làm gì?","image":null,"options":[{"key":"A","text":"Xác định chính tiến trình hiện tại"},{"key":"B","text":"Ghi nhận tiến trình cha và hỗ trợ biểu diễn cây tiến trình"},{"key":"C","text":"Lưu độ ưu tiên lập lịch"},{"key":"D","text":"Lưu địa chỉ trả về của hàm"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-26","clusterId":null},{"startLine":162,"text":"Trong UNIX/Linux, tiến trình cha dùng lời gọi nào để nhận trạng thái kết thúc của tiến trình con?","image":null,"options":[{"key":"A","text":"fork()"},{"key":"B","text":"exec()"},{"key":"C","text":"wait() hoặc waitpid()"},{"key":"D","text":"exit()"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-27","clusterId":null},{"startLine":168,"text":"Tiến trình Zombie là tiến trình nào?","image":null,"options":[{"key":"A","text":"Con đã kết thúc nhưng cha chưa gọi wait(), còn giữ bản ghi tối thiểu về PID và trạng thái"},{"key":"B","text":"Cha kết thúc trước con"},{"key":"C","text":"Tiến trình bị chặn vì chờ I/O"},{"key":"D","text":"Tiến trình đang chạy vô hạn"}],"correct":["A"],"explanationHtml":null,"multi":false,"id":"mcq-28","clusterId":null},{"startLine":174,"text":"Tiến trình Orphan xuất hiện khi nào?","image":null,"options":[{"key":"A","text":"Con kết thúc nhưng cha chưa wait()"},{"key":"B","text":"Cha kết thúc trước con"},{"key":"C","text":"Con gọi exec()"},{"key":"D","text":"Tiến trình chờ I/O quá lâu"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-29","clusterId":null},{"startLine":181,"text":"Tiến trình con thực hiện chuỗi thao tác nào?","image":null,"options":[{"key":"A","text":"wait() → exec(ls) → exit()"},{"key":"B","text":"exec(ls) → fork() → wait()"},{"key":"C","text":"fork() → exec(ls) → exit()"},{"key":"D","text":"exit() → fork() → exec(ls)"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-30","clusterId":"mcq-c4"},{"startLine":187,"text":"Sau khi tạo con, tiến trình cha (shell) làm gì?","image":null,"options":[{"key":"A","text":"Gọi exec(ls) thay ảnh của chính nó"},{"key":"B","text":"Kết thúc ngay lập tức"},{"key":"C","text":"Gọi wait(), nhận trạng thái rồi hiện prompt mới"},{"key":"D","text":"Chuyển sang trạng thái Zombie"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-31","clusterId":"mcq-c4"},{"startLine":193,"text":"PCB là viết tắt của cụm từ nào?","image":null,"options":[{"key":"A","text":"Process Control Block"},{"key":"B","text":"Program Control Buffer"},{"key":"C","text":"Process Counter Block"},{"key":"D","text":"Program Context Base"}],"correct":["A"],"explanationHtml":null,"multi":false,"id":"mcq-32","clusterId":null},{"startLine":200,"text":"PCB được lưu ở đâu?","image":null,"options":[{"key":"A","text":"Trong vùng Text của chương trình người dùng"},{"key":"B","text":"Trong heap của tiến trình"},{"key":"C","text":"Trong vùng nhớ của nhân hệ điều hành"},{"key":"D","text":"Trên stack của tiến trình"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-33","clusterId":"mcq-c5"},{"startLine":206,"text":"Nhóm thông tin \"Định danh\" gồm những mục nào?","image":null,"options":[{"key":"A","text":"Program Counter, Stack Pointer"},{"key":"B","text":"PID, PPID, UID/GID"},{"key":"C","text":"Độ ưu tiên, con trỏ hàng đợi"},{"key":"D","text":"Bảng trang, bảng đoạn"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-34","clusterId":"mcq-c5"},{"startLine":212,"text":"Nhóm thông tin \"Ngữ cảnh CPU\" gồm những mục nào?","image":null,"options":[{"key":"A","text":"PID, PPID"},{"key":"B","text":"Thời gian CPU, giới hạn tài nguyên"},{"key":"C","text":"Độ ưu tiên, con trỏ hàng đợi"},{"key":"D","text":"PC, SP, thanh ghi"}],"correct":["D"],"explanationHtml":null,"multi":false,"id":"mcq-35","clusterId":"mcq-c5"},{"startLine":218,"text":"Bảng trang, bảng đoạn và thanh ghi base/limit thuộc nhóm thông tin nào?","image":null,"options":[{"key":"A","text":"Bộ nhớ"},{"key":"B","text":"Lập lịch"},{"key":"C","text":"Định danh"},{"key":"D","text":"Kế toán và bảo vệ"}],"correct":["A"],"explanationHtml":null,"multi":false,"id":"mcq-36","clusterId":"mcq-c5"},{"startLine":224,"text":"Danh sách tệp đang mở và thiết bị được cấp thuộc nhóm thông tin nào?","image":null,"options":[{"key":"A","text":"Định danh"},{"key":"B","text":"Ngữ cảnh CPU"},{"key":"C","text":"I/O và tệp"},{"key":"D","text":"Trạng thái"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-37","clusterId":"mcq-c5"},{"startLine":230,"text":"Thông tin nào sau đây thuộc nhóm \"Kế toán và bảo vệ\"?","image":null,"options":[{"key":"A","text":"Program Counter"},{"key":"B","text":"Con trỏ hàng đợi sẵn sàng"},{"key":"C","text":"Bảng trang"},{"key":"D","text":"Thời gian CPU đã dùng, giới hạn tài nguyên, quyền"}],"correct":["D"],"explanationHtml":null,"multi":false,"id":"mcq-38","clusterId":"mcq-c5"},{"startLine":237,"text":"Ready queue chứa những PCB nào?","image":null,"options":[{"key":"A","text":"Các PCB đang chờ thiết bị I/O"},{"key":"B","text":"Các PCB chỉ còn chờ được cấp CPU"},{"key":"C","text":"Các PCB đã kết thúc"},{"key":"D","text":"Các PCB đang chạy trên CPU"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-39","clusterId":"mcq-c6"},{"startLine":243,"text":"Khi I/O hoàn tất, PCB trong Device queue được chuyển đến đâu?","image":null,"options":[{"key":"A","text":"CPU để chạy ngay"},{"key":"B","text":"Ready queue"},{"key":"C","text":"Terminated"},{"key":"D","text":"Cuối Device queue khác"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-40","clusterId":"mcq-c6"},{"startLine":250,"text":"Hệ điều hành lưu trạng thái của tiến trình cũ vào đâu?","image":null,"options":[{"key":"A","text":"Vào stack của tiến trình mới"},{"key":"B","text":"Vào PCB tương ứng của tiến trình cũ"},{"key":"C","text":"Vào heap của tiến trình cũ"},{"key":"D","text":"Vào Ready queue"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-41","clusterId":"mcq-c7"},{"startLine":256,"text":"Thời gian chuyển đổi ngữ cảnh được xem là gì?","image":null,"options":[{"key":"A","text":"Thời gian thực hiện công việc hữu ích của ứng dụng"},{"key":"B","text":"Thời gian chờ I/O"},{"key":"C","text":"Chi phí quản lý, hệ thống chưa thực hiện công việc hữu ích của ứng dụng"},{"key":"D","text":"Thời gian chờ trong Ready queue"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-42","clusterId":"mcq-c7"},{"startLine":262,"text":"Việc chuyển ngữ cảnh giữa các luồng cùng tiến trình thường như thế nào so với giữa các tiến trình?","image":null,"options":[{"key":"A","text":"Nhẹ hơn vì chia sẻ không gian địa chỉ và nhiều tài nguyên"},{"key":"B","text":"Nặng hơn vì phải đổi không gian địa chỉ"},{"key":"C","text":"Hoàn toàn giống nhau"},{"key":"D","text":"Không cần lưu thanh ghi"}],"correct":["A"],"explanationHtml":null,"multi":false,"id":"mcq-43","clusterId":"mcq-c7"},{"startLine":268,"text":"Trong lập lịch tiến trình, mục tiêu nào cần cực đại hóa?","image":null,"options":[{"key":"A","text":"Thời gian chờ"},{"key":"B","text":"Thời gian quay vòng"},{"key":"C","text":"Tính tận dụng CPU và thông lượng"},{"key":"D","text":"Thời gian phản ứng"}],"correct":["C"],"explanationHtml":null,"multi":false,"id":"mcq-44","clusterId":null},{"startLine":274,"text":"Thuật toán FCFS chọn tiến trình kế tiếp dựa trên tiêu chí nào?","image":null,"options":[{"key":"A","text":"Thời gian burst nhỏ nhất"},{"key":"B","text":"Thứ tự đến (AT tăng dần)"},{"key":"C","text":"Độ ưu tiên cao nhất"},{"key":"D","text":"Thời gian còn lại ngắn nhất"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-45","clusterId":null},{"startLine":280,"text":"Công thức tính thời gian chờ (WT) trong bài là gì?","image":null,"options":[{"key":"A","text":"WT = CT + AT + BT"},{"key":"B","text":"WT = CT - AT - BT"},{"key":"C","text":"WT = BT - AT"},{"key":"D","text":"WT = CT - BT"}],"correct":["B"],"explanationHtml":null,"multi":false,"id":"mcq-46","clusterId":null},{"startLine":287,"text":"Thời gian chờ trung bình của FCFS là bao nhiêu?","image":null,"options":[{"key":"A","text":"4"},{"key":"B","text":"3"},{"key":"C","text":"4.75"},{"key":"D","text":"7"}],"correct":["C"],"explanationHtml":"Gantt: P1 (0–7), P2 (7–11), P3 (11–12), P4 (12–16).<br>WT = 0, 5, 7, 7 → Ttb = 19/4 = <b>4.75</b>.","multi":false,"id":"mcq-47","clusterId":"mcq-c8"},{"startLine":294,"text":"Thời gian chờ trung bình của SJF không chiếm đoạt là bao nhiêu?","image":null,"options":[{"key":"A","text":"4.75"},{"key":"B","text":"3"},{"key":"C","text":"7"},{"key":"D","text":"4"}],"correct":["D"],"explanationHtml":"Gantt: P1 (0–7), P3 (7–8), P2 (8–12), P4 (12–16).<br>WT = 0, 6, 3, 7 → Ttb = 16/4 = <b>4</b>.","multi":false,"id":"mcq-48","clusterId":"mcq-c8"},{"startLine":301,"text":"Thời gian chờ trung bình của SJF chiếm đoạt (SRTF) là bao nhiêu?","image":null,"options":[{"key":"A","text":"3"},{"key":"B","text":"4"},{"key":"C","text":"4.75"},{"key":"D","text":"7"}],"correct":["A"],"explanationHtml":"Gantt: P1 (0–2), P2 (2–4), P3 (4–5), P2 (5–7), P4 (7–11), P1 (11–16).<br>WT = 9, 1, 0, 2 → Ttb = 12/4 = <b>3</b>.","multi":false,"id":"mcq-49","clusterId":"mcq-c8"},{"startLine":308,"text":"Thời gian chờ trung bình của Round Robin (q = 3) là bao nhiêu?","image":null,"options":[{"key":"A","text":"3"},{"key":"B","text":"4.75"},{"key":"C","text":"7"},{"key":"D","text":"4"}],"correct":["C"],"explanationHtml":"Gantt: P1 (0–3), P2 (3–6), P1 (6–9), P3 (9–10), P4 (10–13), P2 (13–14), P1 (14–15), P4 (15–16).<br>WT = 8, 8, 5, 7 → Ttb = 28/4 = <b>7</b>.<br>Với bộ dữ liệu này, SJF chiếm đoạt cho Ttb nhỏ nhất.","multi":false,"id":"mcq-50","clusterId":"mcq-c8"}],"clusters":[{"id":"mcq-c1","from":3,"to":7,"text":"Không gian địa chỉ của một tiến trình được chia thành các vùng: <b>Text, Data, Heap, Stack</b>. Dùng dữ kiện này trả lời năm câu sau.","image":null,"questionIds":["mcq-3","mcq-4","mcq-5","mcq-6","mcq-7"]},{"id":"mcq-c2","from":12,"to":14,"text":"Trong sơ đồ trạng thái, mỗi tiến trình ở một trong các trạng thái: <b>New, Ready, Running, Waiting, Terminated</b>. Dùng dữ kiện này trả lời ba câu sau.","image":null,"questionIds":["mcq-12","mcq-13","mcq-14"]},{"id":"mcq-c3","from":15,"to":21,"text":"Tiến trình chuyển giữa các trạng thái <b>New, Ready, Running, Waiting, Terminated</b> thông qua các sự kiện như admitted, dispatch, interrupt, chờ I/O hoặc sự kiện, I/O hoàn tất và exit. Dùng dữ kiện này trả lời bảy câu sau.","image":null,"questionIds":["mcq-15","mcq-16","mcq-17","mcq-18","mcq-19","mcq-20","mcq-21"]},{"id":"mcq-c4","from":30,"to":31,"text":"Shell thực thi lệnh ngoài <code>ls -l</code>: shell (tiến trình cha) tạo một tiến trình con để chạy lệnh này. Dùng dữ kiện này trả lời hai câu sau.","image":null,"questionIds":["mcq-30","mcq-31"]},{"id":"mcq-c5","from":33,"to":38,"text":"Hệ điều hành quản lý mỗi tiến trình bằng một <b>PCB</b>, trong đó thông tin được chia thành nhiều nhóm. Dùng dữ kiện này trả lời sáu câu sau.","image":null,"questionIds":["mcq-33","mcq-34","mcq-35","mcq-36","mcq-37","mcq-38"]},{"id":"mcq-c6","from":39,"to":40,"text":"Hệ điều hành tổ chức các PCB vào nhiều hàng đợi khác nhau, chẳng hạn <b>Ready queue</b> và <b>Device queue</b>, tùy theo tình trạng của tiến trình. Dùng dữ kiện này trả lời hai câu sau.","image":null,"questionIds":["mcq-39","mcq-40"]},{"id":"mcq-c7","from":41,"to":43,"text":"Khi CPU chuyển từ tiến trình này sang tiến trình khác, hệ điều hành phải thực hiện <b>chuyển đổi ngữ cảnh</b> (context switch). Dùng dữ kiện này trả lời ba câu sau.","image":null,"questionIds":["mcq-41","mcq-42","mcq-43"]},{"id":"mcq-c8","from":47,"to":50,"text":"Cho bảng tiến trình sau (AT: thời điểm đến, BT: thời gian burst):<br><b>P1</b> (AT=0, BT=7)<br><b>P2</b> (AT=2, BT=4)<br><b>P3</b> (AT=4, BT=1)<br><b>P4</b> (AT=5, BT=4)<br>Dùng dữ kiện này trả lời bốn câu sau, với <b>WT = CT − AT − BT</b>.","image":null,"questionIds":["mcq-47","mcq-48","mcq-49","mcq-50"]}]}}},"inShare":"57b9ae6979f78ee77fe0e3b6"}